#!/usr/bin/env python3
"""cubie-ota - GitHub-release OTA for the Radxa Cubie A5E image.

Firmware = kernel Image + board dtb + kernel modules. Bootloader (boot0/TOC1)
is never touched: it comes from Radxa's image and stays where it is.

Safety model: the new firmware boots first from its own slot. The previous slot
is kept until a full boot reaches multi-user and stays up for a grace period
(cubie-ota-confirm.service). If userspace never confirms within MAX_ATTEMPTS
boots, cubie-ota-boot.service restores the previous slot and reboots.
"""

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request

CONF = "/etc/cubie-ota.conf"
STATE_DIR = "/var/lib/cubie-ota"
STATE = os.path.join(STATE_DIR, "state.json")
SLOT_ROOT = "/boot/ota"
EXTLINUX = "/boot/extlinux/extlinux.conf"
MODULES = "/lib/modules"
DEFAULTS = {
    "repo": "beastbroak30/cubie-a5e-debian",
    "asset": "cubie-a5e-firmware.tar.zst",
    "manifest": "cubie-ota.json",
    "release_file": "/etc/cubie-a5e-release",
    "max_attempts": "3",
    "keep_slots": "2",
    "arch": "arm64",
}


def conf():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip().strip('"')
    except FileNotFoundError:
        pass
    return cfg


def installed_version(cfg):
    try:
        with open(cfg["release_file"]) as f:
            for line in f:
                if line.startswith("VERSION="):
                    return line.split("=", 1)[1].strip()
    except FileNotFoundError:
        pass
    return "0.0.0"


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def load_state():
    try:
        with open(STATE) as f:
            st = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        st = {}
    st.setdefault("version", installed_version(conf()))
    st.setdefault("slot", None)
    st.setdefault("pending", False)
    st.setdefault("pending_version", None)
    st.setdefault("attempts", 0)
    st.setdefault("previous", None)
    return st


def save_state(st):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, sort_keys=True)
    os.replace(tmp, STATE)


def api(url):
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "cubie-ota",
    })
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def gh_get(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": "cubie-ota"})
    with urllib.request.urlopen(req, timeout=120) as r, open(dest, "wb") as f:
        shutil.copyfileobj(r, f, 1 << 20)


def latest_release(cfg):
    return api("https://api.github.com/repos/%s/releases/latest" % cfg["repo"])


def find_asset(release, name):
    for a in release.get("assets", []):
        if a["name"] == name:
            return a
    return None


def cmd_status(_args):
    cfg, st = conf(), load_state()
    print("installed version : %s" % st["version"])
    print("boot slot         : %s" % st["slot"])
    print("pending           : %s" % (st["pending_version"] if st["pending"] else "no"))
    print("previous slot     : %s" % st["previous"])
    print("boot attempts     : %s / %s" % (st["attempts"], cfg["max_attempts"]))
    print("slots on disk     : %s" % ", ".join(sorted(os.listdir(SLOT_ROOT)))
          if os.path.isdir(SLOT_ROOT) else "slots on disk     : none")
    return 0


def cmd_check(args):
    cfg, st = conf(), load_state()
    try:
        rel = latest_release(cfg)
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError) as e:
        print("cubie-ota: update check failed: %s" % e)
        return 0 if args.apt else 1
    tag = rel.get("tag_name", "").lstrip("vV")
    man = find_asset(rel, cfg["manifest"])
    if not man:
        print("cubie-ota: release %s has no %s" % (tag, cfg["manifest"]))
        return 0
    if tag == st["version"]:
        print("cubie-ota: up to date (%s)" % tag)
        return 0
    print("cubie-ota: %s available (installed %s)" % (tag, st["version"]))
    if args.apt:
        print("cubie-ota: run 'sudo cubie-ota apply' to stage it, or reboot after apply")
    return 0


def extract_bundle(path, dest):
    with tarfile.open(path, "r:*") as tf:
        for m in tf.getmembers():
            if m.name.startswith("/") or ".." in m.name.split("/"):
                raise RuntimeError("unsafe path in bundle: %s" % m.name)
        tf.extractall(dest)


def root_partuuid():
    """PARTUUID of the root filesystem. PARTUUID (not UUID) so no initrd is needed."""
    src = subprocess.run(["findmnt", "-no", "SOURCE", "/"],
                         capture_output=True, text=True).stdout.strip()
    if not src:
        src = "/dev/mmcblk0p3"
    out = subprocess.run(["blkid", "-s", "PARTUUID", "-o", "value", src],
                         capture_output=True, text=True, check=True).stdout.strip()
    if not out:
        raise RuntimeError("cannot read PARTUUID of %s" % src)
    return out


def write_extlinux(version, boot_dtb):
    slot = os.path.join(SLOT_ROOT, version)
    text = (
        "default l0\n"
        "menu title Radxa Cubie A5E Boot Options\n"
        "prompt 0\n"
        "timeout 0\n"
        "\n"
        "label l0\n"
        "    menu label Debian GNU/Linux 12 (bookworm) %s\n"
        "    linux %s/Image\n"
        "    fdt %s/%s\n"
        "    append root=PARTUUID=%s console=ttyAS0,115200n8 rootwait rw rootfstype=ext4 "
        "quiet loglevel=3 systemd.show_status=0 udev.log_level=3 audit=0 nowatchdog "
        "nmi_watchdog=0 panic=10 clk_ignore_unused mac_addr=${mac} mac1_addr=${mac1} "
        "coherent_pool=2M irqchip.gicv3_pseudo_nmi=0 cgroup_enable=cpuset "
        "cgroup_memory=1 cgroup_enable=memory swapaccount=1 kasan=off\n"
    )
    # kernel mounts the rootfs itself, so root must be PARTUUID or /dev/*,
    # never UUID=: that needs an initrd.
    root_part = root_partuuid()
    with open(EXTLINUX + ".tmp", "w") as f:
        f.write(text % (version, slot, slot, boot_dtb, root_part))
    os.replace(EXTLINUX + ".tmp", EXTLINUX)


def install_modules(slot):
    tar = os.path.join(slot, "modules.tar.zst")
    if not os.path.exists(tar):
        return
    subprocess.run(["tar", "--zstd", "-xf", tar, "-C", "/"], check=True)


def cmd_apply(args):
    cfg, st = conf(), load_state()
    rel = latest_release(cfg)
    tag = rel.get("tag_name", "").lstrip("vV")
    if not tag:
        print("cubie-ota: release has no tag")
        return 1
    if tag == st["version"] and not args.force:
        print("cubie-ota: already on %s" % tag)
        return 0
    bundle = find_asset(rel, cfg["asset"])
    man = find_asset(rel, cfg["manifest"])
    if not bundle or not man:
        print("cubie-ota: release %s missing %s or %s" % (tag, cfg["asset"], cfg["manifest"]))
        return 1

    os.makedirs(SLOT_ROOT, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=STATE_DIR) as tmp:
        man_path = os.path.join(tmp, "manifest.json")
        bun_path = os.path.join(tmp, "bundle.tar.zst")
        gh_get(man["browser_download_url"], man_path)
        with open(man_path) as f:
            meta = json.load(f)
        expected = meta.get("sha256", "")
        gh_get(bundle["browser_download_url"], bun_path)
        actual = sha256_file(bun_path)
        if expected and actual != expected:
            print("cubie-ota: checksum mismatch\n  expected %s\n  actual   %s" % (expected, actual))
            return 1
        print("cubie-ota: checksum verified (%s)" % actual[:16])

        slot = os.path.join(SLOT_ROOT, tag)
        shutil.rmtree(slot, ignore_errors=True)
        os.makedirs(slot)
        extract_bundle(bun_path, slot)
        if not os.path.exists(os.path.join(slot, "Image")):
            print("cubie-ota: bundle has no Image")
            return 1

    dtb = meta.get("dtb", "sun55i-a527-cubie-a5e.dtb")
    install_modules(slot)
    write_extlinux(tag, dtb)

    st["previous"] = st["slot"] or st["version"]
    st["pending"] = True
    st["pending_version"] = tag
    st["slot"] = tag
    st["attempts"] = 0
    save_state(st)
    print("cubie-ota: %s staged in %s" % (tag, slot))
    print("cubie-ota: reboot to boot it; previous firmware kept until a good boot confirms")
    return 0


def cmd_confirm(_args):
    cfg, st = conf(), load_state()
    if not st["pending"]:
        st["attempts"] = 0
        save_state(st)
        return 0
    st["version"] = st["pending_version"]
    st["pending"] = False
    st["attempts"] = 0
    save_state(st)
    with open(cfg["release_file"], "w") as f:
        f.write("VERSION=%s\n" % st["version"])
    prune_slots(cfg, st)
    subprocess.run(["systemctl", "restart", "aic8800-bt.service"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("cubie-ota: boot confirmed for %s" % st["version"])
    return 0


def prune_slots(cfg, st):
    keep = int(cfg["keep_slots"])
    versions = sorted((d for d in os.listdir(SLOT_ROOT)
                       if os.path.isdir(os.path.join(SLOT_ROOT, d))),
                      key=lambda v: os.path.getmtime(os.path.join(SLOT_ROOT, v)),
                      reverse=True)
    protected = {st["version"], st["previous"]}
    for old in versions[keep:]:
        if old in protected:
            continue
        shutil.rmtree(os.path.join(SLOT_ROOT, old), ignore_errors=True)
        print("cubie-ota: pruned slot %s" % old)


def cmd_boot_guard(_args):
    """Early boot: count attempts, roll back after MAX_ATTEMPTS without confirm.

    shortcut: a kernel that panics before init cannot roll itself back (no
    persistent U-Boot env on this board), upgrade to a bootloader bootcount
    when fw_setenv works on the board.
    """
    cfg, st = conf(), load_state()
    if not st["pending"]:
        return 0
    st["attempts"] = int(st["attempts"]) + 1
    save_state(st)
    if st["attempts"] <= int(cfg["max_attempts"]):
        return 0

    prev = st["previous"]
    print("cubie-ota: %s failed %s boots, rolling back to %s"
          % (st["pending_version"], st["attempts"], prev))
    prev_slot = os.path.join(SLOT_ROOT, prev) if prev else None
    if not prev_slot or not os.path.isdir(prev_slot):
        prev_slot = os.path.join(SLOT_ROOT, st["version"])
    install_modules(prev_slot)
    write_extlinux(os.path.basename(prev_slot), "sun55i-a527-cubie-a5e.dtb")
    st["pending"] = False
    st["pending_version"] = None
    st["slot"] = os.path.basename(prev_slot)
    st["attempts"] = 0
    save_state(st)
    subprocess.run(["systemctl", "reboot"], check=False)
    return 0


def cmd_rollback(_args):
    cfg, st = conf(), load_state()
    prev = st["previous"]
    if not prev or not os.path.isdir(os.path.join(SLOT_ROOT, prev)):
        print("cubie-ota: no previous slot to roll back to")
        return 1
    install_modules(os.path.join(SLOT_ROOT, prev))
    write_extlinux(prev, "sun55i-a527-cubie-a5e.dtb")
    st["slot"] = prev
    st["version"] = prev
    st["pending"] = False
    st["pending_version"] = None
    st["attempts"] = 0
    save_state(st)
    with open(cfg["release_file"], "w") as f:
        f.write("VERSION=%s\n" % prev)
    print("cubie-ota: rolled back to %s, reboot to activate" % prev)
    return 0


def main():
    ap = argparse.ArgumentParser(prog="cubie-ota")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    c = sub.add_parser("check")
    c.add_argument("--apt", action="store_true")
    a = sub.add_parser("apply")
    a.add_argument("--force", action="store_true")
    sub.add_parser("confirm")
    sub.add_parser("boot-guard")
    sub.add_parser("rollback")
    args = ap.parse_args()
    handler = {
        "status": cmd_status,
        "check": cmd_check,
        "apply": cmd_apply,
        "confirm": cmd_confirm,
        "boot-guard": cmd_boot_guard,
        "rollback": cmd_rollback,
    }[args.cmd]
    return handler(args)


if __name__ == "__main__":
    sys.exit(main())
