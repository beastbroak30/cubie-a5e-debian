[Unit]
Description=Cubie A5E OTA boot guard (count attempt, roll back after N failures)
DefaultDependencies=no
After=local-fs.target
Before=basic.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/cubie-ota boot-guard
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=sysinit.target
