{
  "board": "Radxa Cubie A5E",
  "soc": "Allwinner A527 (sun55i)",
  "source": "https://docs.radxa.com/en/cubie/a5e/hardware-use/pin-gpio",
  "source_author": "Radxa Computer (Shenzhen) Co., Ltd",
  "source_license": "CC BY 4.0",
  "verified": "2026-11-21",
  "numbering_rule": {
    "gpiochip1": "banks PA..PK, line = num + 32 * bank_index (A=0 .. K=10), 352 lines",
    "gpiochip0": "banks PL..PM, line = num + 32 * bank_index (L=0, M=1), 64 lines",
    "kernel_check": "gpiochip1 = 2000000.pinctrl (352), gpiochip0 = 64; PL12 -> chip0 line 12 shown as PIN_15, PB4 -> chip1 line 36 shown as PIN_5"
  },
  "pins": [
    { "pin": 1,  "power": "3V3" },
    { "pin": 2,  "power": "5V" },
    { "pin": 3,  "gpio": "PB5",  "chip": 1, "line": 37, "af": ["TWI1-SDA", "HDMI-SDA", "PWM0-9", "TRACE-CLK", "I2S0-BCLK"] },
    { "pin": 4,  "power": "5V" },
    { "pin": 5,  "gpio": "PB4",  "chip": 1, "line": 36, "af": ["TWI1-SCK", "HDMI-SCL", "PWM0-8", "TRACE-DATA2", "I2S0-MCLK"] },
    { "pin": 6,  "power": "GND" },
    { "pin": 7,  "gpio": "PI7",  "chip": 1, "line": 263, "af": ["SPI2-CLK", "PWM0-8", "UART4-CTS", "UART6-RX"] },
    { "pin": 8,  "gpio": "PB9",  "chip": 1, "line": 41,  "af": ["UART0-TX", "TWI0-SCK", "TRACE-DATA1", "I2S0-DIN2"] },
    { "pin": 9,  "power": "GND" },
    { "pin": 10, "gpio": "PB10", "chip": 1, "line": 42,  "af": ["UART0-RX", "TWI0-SDA", "PWM0-1", "I2S0-DIN3"] },
    { "pin": 11, "gpio": "PI9",  "chip": 1, "line": 265, "af": ["PWM0-10", "DMIC-DATA2", "TWI5-SDA"] },
    { "pin": 12, "gpio": "PI2",  "chip": 1, "line": 258, "af": ["UART5-TX", "SPI1-CS0", "PWM0-3", "I2S2-BCLK"] },
    { "pin": 13, "gpio": "PI10", "chip": 1, "line": 266, "af": ["I2S2-MCLK", "PWM0-11", "DMIC-DATA1", "OWA-OUT"] },
    { "pin": 14, "power": "GND" },
    { "pin": 15, "gpio": "PL12", "chip": 0, "line": 12,  "af": ["S-SPI0-MOSI", "DMIC-DATA2", "S-UART0-TX", "MCU-PWM0-6", "S-TWI2-SCK"] },
    { "pin": 16, "gpio": "PI11", "chip": 1, "line": 267, "af": ["UART3-TX", "DMIC-DATA0", "PWM0-12"] },
    { "pin": 17, "power": "3V3" },
    { "pin": 18, "gpio": "PI14", "chip": 1, "line": 270, "af": ["UART6-RTS", "DMIC-CLK", "PWM0-15"] },
    { "pin": 19, "gpio": "PB13", "chip": 1, "line": 45,  "af": ["SPI1-MOSI", "PWM0-4", "UART7-TX", "TWI4-SCK"] },
    { "pin": 20, "power": "GND" },
    { "pin": 21, "gpio": "PB14", "chip": 1, "line": 46,  "af": ["SPI1-MISO", "PWM0-5", "UART7-RX", "TWI4-SDA"] },
    { "pin": 22, "gpio": "PL13", "chip": 0, "line": 13,  "af": ["S-TWI2-SDA", "MCU-PWM0-7", "S-UART0-RX", "DMIC-DATA3", "S-SPI-MISO"] },
    { "pin": 23, "gpio": "PB12", "chip": 1, "line": 44,  "af": ["SPI1-CLK", "PWM0-3", "UART7-CTS", "TWI5-SDA"] },
    { "pin": 24, "gpio": "PB11", "chip": 1, "line": 43,  "af": ["TWI5-SCK", "UART7-RTS", "PWM0-2", "SPI1-CS0"] },
    { "pin": 25, "power": "GND" },
    { "pin": 26, "gpio": "PI0",  "chip": 1, "line": 256, "af": ["TWI4-SCK", "UART4-TX", "PWM0-1", "I2S2-DIN3"] },
    { "pin": 27, "gpio": "PI16", "chip": 1, "line": 272, "af": ["PWM1-1", "TWI2-SDA", "UART3-CTS"] },
    { "pin": 28, "gpio": "PI15", "chip": 1, "line": 271, "af": ["TWI2-SCK", "UART3-RTS", "PWM1-0"] },
    { "pin": 29, "gpio": "PI8",  "chip": 1, "line": 264, "af": ["SPI2-MOSI", "PWM0-9", "IR-RX", "TWI5-SCK"] },
    { "pin": 30, "power": "GND" },
    { "pin": 31, "gpio": "PI12", "chip": 1, "line": 268, "af": ["SPI2-MISO", "PWM0-13", "UART3-RX"] },
    { "pin": 32, "gpio": "PI1",  "chip": 1, "line": 257, "af": ["TWI4-SDA", "UART4-RX", "PWM0-2", "I2S2-DIN2"] },
    { "pin": 33, "gpio": "PI6",  "chip": 1, "line": 262, "af": ["SPI2-CS0", "PWM0-7", "UART6-TX", "UART4-RTS"] },
    { "pin": 34, "power": "GND" },
    { "pin": 35, "gpio": "PI13", "chip": 1, "line": 269, "af": ["I2S2-MCLK", "PWM0-14", "DMIC-DATA3", "UART6-CTS"] },
    { "pin": 36, "gpio": "PI3",  "chip": 1, "line": 259, "af": ["UART5-RX", "PWM0-4", "I2S2-LRCK", "SPI1-CLK"] },
    { "pin": 37, "analog": "GPADC2" },
    { "pin": 38, "gpio": "PI5",  "chip": 1, "line": 261, "af": ["UART5-CTS", "SPI1-MISO", "PWM0-6", "I2S2-DIN0"] },
    { "pin": 39, "power": "GND" },
    { "pin": 40, "gpio": "PI4",  "chip": 1, "line": 260, "af": ["UART5-RTS", "SPI1-MOSI", "PWM0-5", "I2S2-DIN1"] }
  ],
  "known_buses": {
    "i2c": ["TWI1 on PB4/PB5 (pins 5/3)", "TWI4 on PI0/PI1 (pins 26/32)", "TWI5 on PB11/PB12 (pins 24/23)", "TWI2 on PI15/PI16 (pins 28/27)"],
    "spi": ["SPI1 on PB12/PB13/PB14 (pins 23/19/21), CS0 = PB11 (pin 24) or PI2 (pin 12)", "SPI2 on PI7/PI8/PI12 (pins 7/29/31), CS0 = PI6 (pin 33)"],
    "uart": ["UART0 on PB9/PB10 (pins 8/10) - debug console ttyAS0", "UART3 on PI11/PI12 (pins 16/31)", "UART4 on PI0/PI6 (pins 26/33)", "UART5 on PI2/PI3 (pins 12/36)", "UART6 on PI7/PI14 (pins 7/18)", "UART7 on PB13/PB14 (pins 19/21)"],
    "pwm": "PWM0 channels 1..15 across PB/PI banks; must be enabled via rsetup overlay (e.g. Enable PWM0-7 = PI6, pin 33)",
    "adc": "GPADC2 only (pin 37)"
  },
  "rp1_alias_note": "Physical header layout matches Raspberry Pi 40-pin mechanically, but pin functions differ per pin. Map by PHYSICAL pin only; never assume BCM GPIO numbers."
}
